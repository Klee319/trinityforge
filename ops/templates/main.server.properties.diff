# =================================================================================================
#  メインサーバ (既存) の server.properties に対する変更点だけ。
#  現状の値は 2026-07-27 時点の実サーバから読み取ったもの。
#
#  「-」が現在の値、「+」が変更後。記載のないキーは触らない。
# =================================================================================================

# --- プロキシ配下へ移す ---------------------------------------------------------------------------

# 25565 は Velocity が使う。メインは 25566 へ。
- server-port=25565
+ server-port=25566

# 【最重要】外部から直接繋げないようにする。
# modern forwarding は「プロキシから来た」という署名を信頼する仕組みなので、
# バックエンドが 0.0.0.0 で待ち受けていると、誰でも任意のプレイヤー名を名乗って入れる。
# ここを閉じることが forwarding secret と同じくらい重要。
- server-ip=
+ server-ip=127.0.0.1

# プロキシ配下では online-mode はプロキシ側が担当する。
# バックエンドで true のままだと、認証を二重に試みてログインできない。
- online-mode=true
+ online-mode=false

# online-mode=false にする以上、外部からの直結は必ず塞ぐこと (server-ip と Windows Firewall)。
# この2つを同時に満たして初めて安全になる。

# --- RCON ------------------------------------------------------------------------------------------

# ループバックに固定する。パスワードは平文で流れるため外に出してはならない。
# server.properties には rcon の bind 設定が無いので、Windows Firewall で 25575 の
# インバウンドを拒否して担保する (ops/SECURITY.md)。
  enable-rcon=true
  rcon.port=25575
# パスワードは変更を推奨。変更したら環境変数 TF_RCON_MAIN_PASSWORD も更新する。
- rcon.password=tf-local-rcon-2026
+ rcon.password=<十分に長いランダム文字列>

# --- 触らないもの (確認だけ) ------------------------------------------------------------------------

  enable-query=false        # 既に false。維持する
  max-players=25
  view-distance=10
  simulation-distance=6
  difficulty=hard
  pvp=false
  require-resource-pack=true
  resource-pack=https://github.com/Klee319/trinityforge-pack/releases/download/...
  # リソースパックは両サーバとも同じ URL / sha1 を指す。
  # サーバ移動のたびに再ダウンロードさせないよう、プロキシに OneTimePack を入れる。

# --- 任意 (ホワイトリスト運用にする場合) ------------------------------------------------------------

# 25人規模では、無料でできる DDoS/不正接続対策として最も強力。
# ただし Velocity 側で運用するほうが良い (バックエンドに一切到達させずに済む)。
  white-list=false
