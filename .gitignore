# ---- ビルド成果物 ----
build/
# buildDir を変えて走らせたときの生成物（resources/main・test-results・reports が入る）。
# 除外されていないと `git add TrinityForge` で生成物 87 本を巻き込む事故になる。
build-*/
.gradle/
out/
bin/
*.class
# jar は全て再生成物（source/ のベンダー jar、フォークの libs/TrinityForge.jar 含む）。
# 例外は gradle wrapper のみ（これが無いとビルドを起動できない）。
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ---- 依存 ----
node_modules/

# Python のバイトコード。resourcepack/build_item_pack.py が同ディレクトリの
# build_item_lang を import するようになったので、パックを 1 回ビルドしただけで
# resourcepack/__pycache__/ が生えて public リポジトリへ混入しうる。
__pycache__/
*.pyc

# ---- バックアップ（巨大・git で置き換わるもの） ----
backups/
backups.zip
*.bak
.backupdir_marker

# ---- 一時ファイル・ログ ----
tmp/
_build_*.log
*.log
.DS_Store
Thumbs.db

# ---- 独自 git 管理下（このリポジトリの対象外） ----
# 各々が独立したリポジトリなので gitlink 化を避けて除外する。
# 詳細は fork-handoff/README.md を参照。
fork-handoff/arspaper/fork/
fork-handoff/elitemobs/elitemobs-fork/
fork-handoff/husksync/fork/
wiki/

# ---- ローカル環境依存 ----
# 絶対パス（D:\game\...）を含むローカル運用スクリプト
.cursor-rcon.py

# IDE / 言語サーバ（Eclipse JDT）のメタデータ。
# post-check フックの compile が吐くので、worktree を作るたび全ワークツリーに生える。
# 除外していないと wip-audit.ps1 の「他 worktree の未コミット変更」が毎回 47 本 WARN になり、
# 本物の取り残し（実ソースの未コミット変更）がノイズに埋もれる。2026-08-04 に実際に埋もれた。
.project
.classpath
.settings/

# ---- 実サーバ由来の運用データ ----
server.properties
ops.json
whitelist.json
banned-*.json
usercache.json
*.jks
*.pem
.env
.env.*

# ops スクリプトのローカル設定（絶対パスを含む）。ops-config.sample.psd1 だけを版管理する。
ops/ops-config.psd1
